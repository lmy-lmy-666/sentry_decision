<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_decision</name>
  <version>1.0.0</version>
  <description>
    Pure C++ finite-state-machine decision layer for the sentry robot.
    Replaces the BehaviorTree-based sentry_behavior with a dependency-light
    FSM driven by referee/vision data, publishing Nav2 goals. Tactics are
    described by external YAML profiles (config/profiles/*.yaml) selectable at
    launch, with no BehaviorTree.CPP / BehaviorTree.ROS2 dependency.
  </description>
  <maintainer email="boombroke@icloud.com">Boombroke</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_auto</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>radar_msgs</depend>
  <depend>rm_interfaces</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
